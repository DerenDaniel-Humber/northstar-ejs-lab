<a class="back-link" href="/clients">&larr; Back to client directory</a><section class="profile-heading mt-3 mb-4"><p class="eyebrow"><%= record.id %> / CLIENT PROFILE</p><div class="d-flex flex-wrap align-items-center gap-3"><h1 class="mb-0"><%= record.name %></h1><%- include('../partials/riskBadge', {risk: record.riskCategory}) %></div><p class="text-secondary mt-2 mb-0"><%= record.classification %> client &bull; <%= record.city %> &bull; <%= record.status %></p></section><div class="row g-4"><div class="col-lg-8"><section class="card mb-4"><div class="card-body p-4"><h2 class="h4 mb-4">Client information</h2><dl class="row mb-0"><% [['Classification',record.classification],['Risk category',record.riskCategory],['Email',record.email],['Telephone',record.phone],['Location',record.city],['Assigned advisor',record.advisor]].forEach(([label,value]) => { %><dt class="col-sm-4"><%= label %></dt><dd class="col-sm-8"><%= value %></dd><% }) %></dl></div></section><section class="card"><div class="card-body p-4"><h2 class="h4">Advisory notes</h2><p class="text-secondary mb-0"><%= record.notes %></p></div></section></div><div class="col-lg-4"><section class="card financial-card mb-4"><div class="card-body p-4"><p>Assets under advice</p><h2><%= money(record.assetsUnderAdvice) %></h2><small>Canadian dollars</small></div></section><section class="card"><div class="card-body p-4"><h2 class="h4">Review schedule</h2><p class="text-secondary"><%= record.service %></p><dl class="mb-0"><dt>Last review</dt><dd><%= record.lastReview %></dd><dt>Next review</dt><dd class="mb-0"><%= record.nextReview %></dd></dl></div></section></div></div>