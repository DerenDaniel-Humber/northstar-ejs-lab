<div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4"><div><p class="eyebrow">CLIENT OPERATIONS</p><h1>Client directory</h1><p class="text-secondary mb-0">Select a client to review their advisory profile.</p></div><span class="badge text-bg-light border"><%= clients.length %> records</span></div><section class="card"><div class="table-responsive"><table class="table align-middle mb-0"><caption class="visually-hidden">Client records with classification, risk and advisor</caption><thead><tr><th scope="col">Client</th><th scope="col">Classification</th><th scope="col">Risk category</th><th scope="col">Advisor</th><th scope="col">Profile</th></tr></thead><tbody><% clients.forEach(client => { %><tr><td><strong><%= client.name %></strong><small class="d-block text-secondary"><%= client.id %> &bull; <%= client.city %></small></td><td><%= client.classification %></td><td><%- include('../partials/riskBadge', {risk: client.riskCategory}) %></td><td><%= client.advisor %></td><td><a class="btn btn-sm btn-outline-primary" href="/clients/<%= encodeURIComponent(client.id) %>" aria-label="View profile for <%= client.name %>">View profile &rarr;</a></td></tr><% }) %><% if (!clients.length) { %><tr><td colspan="5" class="p-4 text-center">No client records are available.</td></tr><% } %></tbody></table></div></section><p class="text-secondary small mt-3">Risk levels: Low, Moderate and High. Labels accompany colors for accessibility.</p>